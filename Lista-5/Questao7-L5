erros_totais = 0

def labirinto(palavra_magica, quantidade_erros, linha, coluna, visitas, erros_totais): #função do labirinto
    if tamanho_matriz <= coluna or coluna < 0 or tamanho_matriz <= linha or linha < 0: #se a posição não existir
        return (0)
    if erros_totais > quantidade_erros: #se tiver mais erros que o permitido
        return (0)
    if matriz[linha][coluna] == "2": #se encontrou um caminho
        return (1)
    if visitas[linha][coluna] == True: #se já passou por um espaço
        return (0)
    if matriz[linha][coluna] == "0":
        return (0)
    
    if matriz[linha][coluna] not in palavra_magica: #se eu passar por uma letra que tá na palavra
        erros_totais += 1

    visitas[linha][coluna] = True
    caminho_possivel = 0
    caminho_possivel += labirinto(palavra_magica, quantidade_erros, linha + 1, coluna, visitas, erros_totais) #baixo
    if caminho_possivel > 0:
        return(1)
    caminho_possivel += labirinto(palavra_magica, quantidade_erros, linha - 1, coluna, visitas, erros_totais) #cima
    if caminho_possivel > 0:
        return(1)
    caminho_possivel += labirinto(palavra_magica, quantidade_erros, linha, coluna + 1, visitas, erros_totais) #direita
    if caminho_possivel > 0:
        return(1)
    caminho_possivel += labirinto(palavra_magica, quantidade_erros, linha, coluna - 1, visitas, erros_totais) #esquerda
    if caminho_possivel > 0:
        return(1)
    visitas[linha][coluna] = False
    return caminho_possivel

