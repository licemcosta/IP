    print(f"Numero {numero_3d} | Sinal = {sinal_3d} | Indice = {indice_3d} | Memorias = {memoria_3d} | Eco das Luzes = {eco_3d} | Julgamento: {significado_pressagio}")
    for_principal(indice + 1, limite, lista_numeros)

